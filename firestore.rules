rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      // The trip discount relies on these products, so they cannot be deleted.
      allow write: if request.auth != null && request.auth.token.admin == true
        && !(productId in ['boat-hire', 'blue-sub', 'gold-sub'] && (request.resource == null || request.resource.data.get('deleted', false) == true));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}