# Application
VITE_APP_ID=forth-canoe-default
PORT=3000
NODE_ENV=production
VITE_API_BASE_URL=

# GitHub page publishing (server only; never use VITE_ prefix)
GITHUB_CONTENT_TOKEN=github_fine_grained_token_with_repo_contents_read_write
GITHUB_REPOSITORY=Riotshielder21/ForthCCWebsite
GITHUB_BRANCH=main
GITHUB_CONTENT_BRANCH=live/web-admin-edit
GITHUB_COMMIT_EMAIL=website@forthcanoeclub.co.uk
GITHUB_PR_ASSIGNEE=Riotshielder21
GITHUB_PR_NOTIFICATION_EMAIL=Riotshielder21@gmail.com
GITHUB_PR_REVIEWERS=Riotshielder21

# Google Drive / Sheets form storage
# Website Forms folder ID; its delegated user must have access through the Shared Drive.
GOOGLE_FORMS_ROOT_FOLDER_ID=1_ptxNQkgpJdogsjDZ4Wbqb310LCEJI4Z
# Shared Drive ID, not the Test_Website parent folder ID.
GOOGLE_SHARED_DRIVE_ID=0APxBZiGs6yEGUk9PVA
GOOGLE_FORMS_TIMEZONE=Europe/London

# Google Workspace email delivery
# The service account needs domain-wide delegation for Gmail send and Firestore.
GOOGLE_WORKSPACE_DELEGATED_USER=website@forthcanoeclub.co.uk
GOOGLE_WORKSPACE_SENDER=no-reply@forthcanoeclub.co.uk
PUBLIC_SITE_URL=https://forthcanoeclub.co.uk
FIREBASE_SERVICE_ACCOUNT_PATH=./google-service-account.json

# Stripe test mode
# Use the test secret key locally. Never expose it through VITE_ variables.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

