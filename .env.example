# Environment Variables for FCC Website
# Copy to .env and fill in your values

# Firebase Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
VITE_FIREBASE_API_KEY=AIzaSyAhhTHbwnUsUEoF2AbSglmhDRn6-EmMfPs
VITE_FIREBASE_AUTH_DOMAIN=fccwebsite-23cfc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fccwebsite-23cfc
VITE_FIREBASE_STORAGE_BUCKET=fccwebsite-23cfc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=397447736103
VITE_FIREBASE_APP_ID=1:397447736103:web:f3fe3c17578114490b5702
VITE_FIREBASE_MEASUREMENT_ID=G-YV5FW687LQ

# Application
VITE_APP_ID=forth-canoe-default
PORT=3000
NODE_ENV=production

# Google Sheets Integration
# Create a Google Sheet and share it with your service account email
# The sheet should have a tab named "Lists" with headers: Timestamp, Name, Email, List Type, Items, Notes
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Workspace email delivery
# The service account needs domain-wide delegation for Gmail send and Firestore.
GOOGLE_WORKSPACE_DELEGATED_USER=website@forthcanoeclub.co.uk
GOOGLE_WORKSPACE_SENDER=website-noreply@forthcanoeclub.co.uk
PUBLIC_SITE_URL=https://forthcanoeclub.co.uk

# Stripe test mode
# Use the test secret key locally. Never expose it through VITE_ variables.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

