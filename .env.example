# Environment Variables for FCC Website
# Copy to .env and fill in your values
# Live mode: false while testing. When true the site versions consent and policy wording, keeps all records
# (only audited deletes and GDPR erasure remove data) and warns at start-up about missing policies. See DEVELOPMENT.md.
WEBSITE_ISLIVE=false
# Firebase Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
VITE_FIREBASE_API_KEY=your_firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=fccwebsite-23cfc.firebaseapp.com
# After adding Google's OAuth redirect for it, use new.forthcanoeclub.co.uk here (it is served by Firebase Hosting).
# Deployment uses the VITE_FIREBASE_AUTH_DOMAIN repository variable before the secret; see DEVELOPMENT.md.
VITE_FIREBASE_PROJECT_ID=fccwebsite-23cfc
VITE_FIREBASE_STORAGE_BUCKET=fccwebsite-23cfc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=397447736103
VITE_FIREBASE_APP_ID=1:397447736103:web:f3fe3c17578114490b5702
VITE_FIREBASE_MEASUREMENT_ID=G-YV5FW687LQ

# Application
VITE_APP_ID=forth-canoe-default
PORT=3000
VITE_API_BASE_URL=
# Optional Vite development-only proxy target when VITE_API_BASE_URL is empty.
VITE_API_PROXY_TARGET=

# GitHub page publishing (server only; never use VITE_ prefix)
GITHUB_CONTENT_TOKEN=github_fine_grained_token_with_repo_contents_read_write
GITHUB_REPOSITORY=Riotshielder21/ForthCCWebsite
GITHUB_BRANCH=main
GITHUB_CONTENT_BRANCH=live/web-admin-edit
GITHUB_COMMIT_EMAIL=website@forthcanoeclub.co.uk
GITHUB_PR_ASSIGNEE=Riotshielder21
GITHUB_PR_NOTIFICATION_EMAIL=Riotshielder21@gmail.com
GITHUB_PR_REVIEWERS=Riotshielder21

# Google Drive / Sheets form storage
# Website Forms folder ID; its delegated user must have access through the Shared Drive.
GOOGLE_FORMS_ROOT_FOLDER_ID=1_ptxNQkgpJdogsjDZ4Wbqb310LCEJI4Z
# Shared Drive ID, not the Test_Website parent folder ID.
GOOGLE_SHARED_DRIVE_ID=0APxBZiGs6yEGUk9PVA
GOOGLE_FORMS_TIMEZONE=Europe/London

# Google Workspace email delivery
# The service account needs domain-wide delegation for Gmail send and Firestore.
# In the Workspace admin console (Security > API controls > Domain-wide delegation) authorise the service account's
# client ID for https://www.googleapis.com/auth/gmail.send, drive and spreadsheets. The Gmail API must be enabled in
# the Google Cloud project. GOOGLE_WORKSPACE_SENDER must be a mailbox or "send as" alias of the delegated user,
# otherwise Gmail replaces the From address with the delegated user's.
GOOGLE_WORKSPACE_DELEGATED_USER=website@forthcanoeclub.co.uk
GOOGLE_WORKSPACE_SENDER=no-reply@forthcanoeclub.co.uk
# Test frontend origin; configure the production API with its own canonical origin.
PUBLIC_SITE_URL=https://fccwebsite-23cfc.web.app
# Optional comma-separated additional frontend origins allowed for Stripe returns.
#PUBLIC_SITE_URLS=https://forthcanoeclub.co.uk
# Extra browser origins allowed to call the API (comma separated); the site URLs above are always allowed.
CORS_ORIGINS=
FIREBASE_SERVICE_ACCOUNT_PATH=./google-service-account.json

# Stripe test mode
# Use the test secret key locally. Never expose it through VITE_ variables.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_REPORT_SECRET_KEY=
# Restricted Stripe key matching the report mode: subscription/item/schedule/customer read-write
# (including customer deletion for erasure), plus invoice, payment-intent and charge reads.
STRIPE_SUBSCRIPTION_ADMIN_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Keyed hashing of email, name+DOB and membership number in the deletion audit, so GDPR erasure can find
# already-deleted records without storing readable details. Generate a long random value; losing it breaks lookups.
AUDIT_LOOKUP_SECRET=

# Daily renewal-email job (config/fcc-renewals.timer). The API accepts the job only with this token (32+ random characters);
# the timer reads the same token and posts to RENEWAL_JOB_URL, e.g. https://<api-host>/api/jobs/renewals.
RENEWAL_JOB_TOKEN=
RENEWAL_JOB_URL=

# JustGo API (server/jobs only). All calls, including Auth, are blocked by default.
# A secret alone never enables requests. Enable reads first; do not enable writes until tenant mappings are confirmed.
JUSTGO_API_ENABLED=false
JUSTGO_API_WRITES_ENABLED=false
JUSTGO_API_SECRET=
JUSTGO_ORGANISATION_ID=
# Store the secret in Secret Manager (justgo-api-secret) and copy it here on the VM; never commit it.
# Confirm these IDs/status labels with `scripts/justgo-admin.py discover` (read-only); do not invent values.
# {"adult":"<uuid>","junior":"<uuid>"}: FCC's own membership definitions.
JUSTGO_MEMBERSHIP_DEFINITIONS={}
JUSTGO_ACTIVE_MEMBERSHIP_STATUSES=
JUSTGO_ACTIVE_MEMBER_STATUSES=
# {"pvg":"<uuid>","safeguarding":"<uuid>"}
JUSTGO_CREDENTIAL_DEFINITIONS={}
JUSTGO_CLUB_MEMBER_ROLE=
# suspensionLevel values meaning "not suspended" (empty and "none" always count).
JUSTGO_UNSUSPENDED_LEVELS=

# Optional: where Needs attention alerts (payment problems) are emailed. Defaults to the club reply-to address.
# STAFF_ALERT_EMAIL=secretary@forthcanoeclub.co.uk
