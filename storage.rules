rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isClubAdmin() {
      return request.auth != null
        && request.auth.token.admin == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('[^@\\s]+@forthcanoeclub[.]co[.]uk');
    }

    // Admins may choose photos up to 25 MB; the browser resizes them before upload (src/utils/imageProcessing.js),
    // so each stored size, preview fallback and logo stays under 5 MB and the original is never stored.
    match /pages/{pageId}/{tileId}/{fileName} {
      allow read: if true;
      allow write: if isClubAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isClubAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /safeguarding/{fileName} {
      allow read: if true;
      allow write: if isClubAdmin()
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}